# ─── Core ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production-use-strong-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sports:sports@localhost:5432/sports_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_AUTH_URL=redis://localhost:6379/1

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── JWT ──────────────────────────────────────────────────────────────────────
# For local dev, HS256 is used. For production, switch to RS256 with PEM keys.
JWT_SIGNING_KEY=local-dev-jwt-signing-key-change-in-production

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── External Providers (fill in your actual keys) ────────────────────────────
PROVIDER_API_FOOTBALL_KEY=your-api-football-key-here
ODDS_PROVIDER_API_KEY=your-odds-provider-key-here

# ─── AI / RAG ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here

# ─── Push Notifications ───────────────────────────────────────────────────────
FCM_PROJECT_ID=your-firebase-project-id

# ─── Sentry (Production) ──────────────────────────────────────────────────────
SENTRY_DSN=
